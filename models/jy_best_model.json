{
  "model_family": "pytorch",
  "backbone": "resnet18",
  "schema_version": 1,

  "model_config": {
    "use_single_channel": true,
    "num_classes": 2
  },

  "inference_config": {
    "threshold": 0.5,
    "sampling_rate": 1000000
  },

  "stft_config": {
    "nperseg": 128,
    "noverlap": 96,
    "nfft": 256,
    "window": "hann",
    "img_size": 224
  },

  "application_info": {
    "대상 재질": "내화물",
    "대상 부호": "",
    "설명": "ResNet18 STFT 균열 탐지 모델",
    "베포 날짜": "2026-03-18",
    "만든 사람": ""
  }
}
